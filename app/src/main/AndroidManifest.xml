<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.keepnotes">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/notes1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/notes1"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeepNotes">
        <activity
            android:name=".ui.drawing.CreateDrawing"
            android:exported="false"
            android:parentActivityName=".ui.note.AddNoteActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.note.AddNoteActivity" />
        </activity>
        <activity
            android:name=".ui.note.AddNoteActivity"
            android:label="Add Note"
            android:parentActivityName=".ui.main.MainActivity"
            android:theme="@style/AddNoteActivity" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>